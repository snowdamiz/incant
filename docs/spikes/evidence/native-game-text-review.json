  "findings": [
    {
      "priority": "P2",
      "file": "crates/incant_text/src/fonts.rs",
      "lines": [
        76,
        84
      ],
      "title": "Reject faces that the actual shaper cannot load during construction",
      "reproduction": "A named 1928-byte sfnt containing only name metadata is accepted by new, then shape(\"A\") panics at cosmic-text shape.rs275: no default font found. fontdb parses RawFace/name metadata only; cosmic-text uses full Face parse lazily.",
      "fix": "Validate every supplied face through the actual cosmic-text/rustybuzz loader before accepting the engine."
    },
    {
      "priority": "P2",
      "file": "crates/incant_text/src/fonts.rs",
      "lines": [
        84,
        89
      ],
      "title": "Keep explicit font priority independent of unused face style/weight/stretch",
      "reproduction": "Italic-only normal NotoSans bytes with OS/2 italic bit changed constructs then panics for absent default matching font. Weight700 first + same regular400 font second returns fontID2. Attrs always normal400/defaultstretch while upstream filters/sorts retained metadata.",
      "fix": "Provide bounded normalized matching metadata for this unstyled explicit-chain API; preserve actual glyph data unchanged."
    },
    {
      "priority": "P2",
      "file": "crates/incant_text/src/fonts.rs",
      "lines": [
        78,
        84
      ],
      "title": "Avoid unbounded decoded-name amplification before replacing family aliases",
      "reproduction": "646352-byte valid sfnt with2048 family-name records referencing one65534-byte UTF16 string constructs successfully but peaks143507456bytes RSS, versus7979008 for baseline556216bytes. Face clone duplicates67106816 bytes of decoded families; input font bounds alone do not stop amplification.",
      "fix": "Construct bounded private FaceInfo directly from the owned source and actual-shaper validation, or cap decoded name count/bytes before fontdb metadata parsing."
    }
  ],
  "other_source_findings": [],
  "bounded_checks": [
    "No system-font discovery: explicit Binary sources, fresh private database and explicit und locale/fallback; no FontSystem system-font constructor.",
    "Private fixed32 family aliases do not leak allocated static strings; face IDs map to asset ULIDs rather than numeric assumptions.",
    "Input font count/individual/total bytes and text/finite style bounds are enforced before normal shaping; TTC rejected before fontdb face-count allocation.",
    "Absolute UTF8 clusters agree with same LineIter used by Buffer.set_text; CR/LF/CRLF/LFCR and final empty paragraph handling preserve offsets.",
    "Logical glyph offsets match pinned physical-glyph calculation before raster rounding; RTL test assertion uses logical clusters and positions rather than glyph iteration direction.",
    "Published source/glyph/line/missing arrays are immutable and Arc-owned; unchanged inputs return same Arc; cached result replaced only after conversion validation succeeds.",
    "Pinned tests/fonts and OFL license byte-match corresponding cosmic-text0.14.2 packaged assets."
  ],
