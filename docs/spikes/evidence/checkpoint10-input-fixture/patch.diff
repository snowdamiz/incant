+#[test]
+fn supported_recording_versions_preserve_the_same_non_ui_playback() {
+    let temp = tempfile::tempdir().unwrap();
+    let root = temp.path();
+    fixture(root);
+    let mut reports = Vec::new();
+    for version in [1, 2] {
+        let mut recording = clip();
+        recording["version"] = json!(version);
+        fs::write(root.join("input.json"), recording.to_string()).unwrap();
+        reports.push(success(run(
+            root,
+            &[
+                "play",
+                "game.incant.json",
+                "--ticks",
+                "60",
+                "--input-replay",
+                "input.json",
+            ],
+        )));
+    }
+    for key in ["state", "input", "logs"] {
+        assert_eq!(reports[0][key], reports[1][key], "{key}");
+    }
+    assert_eq!(reports[1]["input"]["focused"], false);
+    assert_eq!(reports[1]["input"]["keyboard"]["held"], json!([]));
+}
