(if (i64.ne (i64.load (i32.const 16384)) (i64.const 3760558801514876489)) (then unreachable))
(if (i32.ne (i32.load8_u (i32.add (i32.const 16384) (local.get $length))) (i32.const 165)) (then unreachable))
