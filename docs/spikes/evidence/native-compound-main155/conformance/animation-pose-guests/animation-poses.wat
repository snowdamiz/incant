(func (export "update") (param $epoch i64) (param $dt f64) (local $mode i32) (local $length i32) (local $count i32)
(local.set $mode (i32.trunc_f64_s (f64.mul (local.get $dt) (f64.const 64))))
(call $get (local.get $epoch) (i32.const 0) (i32.const 8192))
