(if (i32.eq (local.get $mode) (i32.const 4)) (then (drop (call $read (local.get $epoch) (i32.const 16384) (i32.const 1)))))
(if (i32.eq (local.get $mode) (i32.const 5)) (then (drop (call $read (local.get $epoch) (i32.const 65000) (i32.const 2048)))))
(if (i32.eq (local.get $mode) (i32.const 6)) (then (drop (call $read (local.get $epoch) (i32.const 16384) (i32.const -1)))))
(if (i32.eq (local.get $mode) (i32.const 7)) (then (drop (call $read (local.get $epoch) (i32.const 16384) (i32.const 2147483647)))))
