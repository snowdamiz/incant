# Generated bindings and canonical project documents must compare identically on
# all CI hosts, including Git for Windows with core.autocrlf enabled.
* text=auto eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
# Preserve the pinned upstream header byte-for-byte, including three comment
# lines ending in spaces. Local code keeps the normal whitespace checks.
third_party/wabt/wasm-rt.h whitespace=-blank-at-eol
# Preserve upstream FBX bytes, including ASCII CRLF and exporter trailing spaces.
# The fixture hash test verifies these unmodified data files on every host.
crates/incant_assets/tests/fixtures/fbx/*.fbx -text whitespace=-blank-at-eol,cr-at-eol

# Preserve exact published cosmic-text license and CRLF regression fixture bytes.
third_party/cosmic-text/fonts/Inter-LICENSE -text whitespace=-blank-at-eol,cr-at-eol
third_party/cosmic-text/sample/crlf.txt -text whitespace=-blank-at-eol,cr-at-eol
# Upstream test inputs and license text keep their published whitespace.
third_party/cosmic-text/benches/layout.rs whitespace=-blank-at-eol
third_party/cosmic-text/fonts/FiraMono-LICENSE whitespace=-blank-at-eol
third_party/cosmic-text/fonts/NotoSans-LICENSE whitespace=-blank-at-eol
third_party/cosmic-text/sample/hebrew.txt whitespace=-blank-at-eol
third_party/cosmic-text/sample/hello.txt whitespace=-blank-at-eol
# Unified diff context lines intentionally contain their leading space.
third_party/cosmic-text/INCANT_PATCH.diff whitespace=-blank-at-eol

# Preserve published Kira sources/licenses, including original CRLF whitespace.
third_party/kira/** -text whitespace=-blank-at-eol,cr-at-eol

# Preserve raw restart evidence logs, including intentional terminal blank lines.
docs/spikes/evidence/native-session-restart/**/*.log -text whitespace=-blank-at-eof
# Preserve the leading space on blank unified-diff context lines.
docs/spikes/evidence/native-restart-main179/integration-manifest.patch -text whitespace=-blank-at-eol
