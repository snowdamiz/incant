{
  "$defs": {
    "Check": {
      "additionalProperties": false,
      "properties": {
        "expect": {
          "$ref": "#/$defs/Expect"
        },
        "name": {
          "description": "Unique descriptive name; at most 120 UTF-8 bytes.",
          "type": "string"
        },
        "path": {
          "description": "JSON Pointer below /state, /script_state or /input.",
          "type": "string"
        },
        "tick": {
          "description": "Absolute game tick, including an initial or restored checkpoint.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "name",
        "tick",
        "path",
        "expect"
      ],
      "type": "object"
    },
    "Expect": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "equals",
              "type": "string"
            },
            "value": true
          },
          "required": [
            "type",
            "value"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "tolerance": {
              "format": "double",
              "type": "number"
            },
            "type": {
              "const": "approx",
              "type": "string"
            },
            "value": {
              "format": "double",
              "type": "number"
            }
          },
          "required": [
            "type",
            "value",
            "tolerance"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "max": {
              "format": "double",
              "type": "number"
            },
            "min": {
              "format": "double",
              "type": "number"
            },
            "type": {
              "const": "range",
              "type": "string"
            }
          },
          "required": [
            "type",
            "min",
            "max"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "exists": {
              "type": "boolean"
            },
            "type": {
              "const": "exists",
              "type": "string"
            }
          },
          "required": [
            "type",
            "exists"
          ],
          "type": "object"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "checks": {
      "items": {
        "$ref": "#/$defs/Check"
      },
      "maxItems": 256,
      "minItems": 1,
      "type": "array"
    },
    "format": {
      "type": "string"
    },
    "version": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "format",
    "version",
    "checks"
  ],
  "title": "PlayAssertions",
  "type": "object"
}
