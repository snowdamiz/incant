            "scale": {
              "default": [
                1.0,
                0.0
              ],
              "items": {
                "format": "double",
                "type": "number"
              },
              "maxItems": 2,
              "minItems": 2,
              "type": "array"
            },
            "type": {
              "const": "gamepad_axis",
              "type": "string"
            }
          },
          "required": [
            "type",
            "id",
            "axis"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "id": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
