            "scale": {
              "default": [
                1.0,
                0.0
              ],
              "items": {
                "format": "double",
                "type": "number"
              },
              "maxItems": 2,
              "minItems": 2,
              "type": "array"
            },
            "type": {
              "const": "gamepad_button",
              "type": "string"
