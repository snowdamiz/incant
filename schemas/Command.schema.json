    "AgentBudgetSettings": {
      "additionalProperties": false,
      "description": "User-authored token allowance for this project. Consumption is stored outside\nthe project; zero disables new agent turns.",
      "properties": {
        "max_tokens": {
          "format": "uint64",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "max_tokens"
      ],
      "type": "object"
    },
    "Asset": {
