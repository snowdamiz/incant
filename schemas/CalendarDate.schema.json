{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "day": {
      "format": "uint8",
      "maximum": 255,
      "minimum": 0,
      "type": "integer"
    },
    "month": {
      "format": "uint8",
      "maximum": 255,
      "minimum": 0,
      "type": "integer"
    },
    "year": {
      "format": "int32",
      "type": "integer"
    }
  },
  "required": [
    "year",
    "month",
    "day"
  ],
  "title": "CalendarDate",
  "type": "object"
}
