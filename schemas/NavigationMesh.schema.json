{
  "$defs": {
    "NavigationSettings": {
      "additionalProperties": false,
      "properties": {
        "agent_height": {
          "format": "float",
          "type": "number"
        },
        "agent_radius": {
          "format": "float",
          "type": "number"
        },
        "cell_height": {
          "format": "float",
          "type": "number"
        },
        "cell_size": {
          "format": "float",
          "type": "number"
        },
        "max": {
          "items": {
            "format": "float",
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "type": "array"
        },
        "max_climb": {
          "format": "float",
          "type": "number"
        },
        "max_slope_degrees": {
          "format": "float",
          "type": "number"
        },
        "min": {
          "description": "World-space build bounds, independent of an entity's local transform.",
          "items": {
            "format": "float",
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "type": "array"
        },
        "tile_cells": {
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "min",
        "max",
        "cell_size",
        "cell_height",
        "tile_cells",
        "agent_radius",
        "agent_height",
        "max_climb",
        "max_slope_degrees"
      ],
      "type": "object"
    },
    "NavigationSource": {
      "additionalProperties": false,
      "properties": {
        "entity": {
          "type": "string"
        },
        "geometry": {
          "$ref": "#/$defs/NavigationSourceKind"
        }
      },
      "required": [
        "entity",
        "geometry"
      ],
      "type": "object"
    },
    "NavigationSourceKind": {
      "enum": [
        "collider",
        "mesh"
      ],
      "type": "string"
    },
    "OffMeshLink": {
      "additionalProperties": false,
      "properties": {
        "bidirectional": {
          "type": "boolean"
        },
        "enabled": {
          "type": "boolean"
        },
        "end": {
          "items": {
            "format": "float",
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "type": "array"
        },
        "extra_cost": {
          "description": "Nonnegative distance-equivalent penalty, added to straight-line length.",
          "format": "float",
          "type": "number"
        },
        "id": {
          "description": "Stable project ULID used by gameplay to choose a traversal behavior.",
          "type": "string"
        },
        "snap_distance": {
          "format": "float",
          "type": "number"
        },
        "start": {
          "items": {
            "format": "float",
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 3,
          "type": "array"
        }
      },
      "required": [
        "id",
        "start",
        "end",
        "snap_distance",
        "bidirectional",
        "enabled",
        "extra_cost"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "links": {
      "default": [],
      "items": {
        "$ref": "#/$defs/OffMeshLink"
      },
      "maxItems": 128,
      "type": "array"
    },
    "settings": {
      "$ref": "#/$defs/NavigationSettings"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/NavigationSource"
      },
      "maxItems": 1024,
      "type": "array"
    }
  },
  "required": [
    "settings",
    "sources"
  ],
  "title": "NavigationMesh",
  "type": "object"
}
