{
  "$defs": {
    "OffMeshTraversal": {
      "properties": {
        "from_index": {
          "description": "The consecutive point pair crosses a link, not walkable mesh.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "link_id": {
          "type": "string"
        },
        "reversed": {
          "type": "boolean"
        },
        "to_index": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "link_id",
        "from_index",
        "to_index",
        "reversed"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "corridor": {
      "items": {
        "format": "uint32",
        "minimum": 0,
        "type": "integer"
      },
      "type": "array"
    },
    "generation": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "points": {
      "description": "World-space points on the quantized navigation surface. Voxel/detail\nsampling approximates height and rounds steps; use physics for grounding\nor exact surface placement. The chosen corridor may include tile bends.",
      "items": {
        "items": {
          "format": "float",
          "type": "number"
        },
        "maxItems": 3,
        "minItems": 3,
        "type": "array"
      },
      "type": "array"
    },
    "traversals": {
      "description": "Consecutive point pairs that require explicit gameplay traversal. Never\ntreat these as walkable segments or feed them directly to ground steering.",
      "items": {
        "$ref": "#/$defs/OffMeshTraversal"
      },
      "type": "array"
    },
    "visited": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "points",
    "corridor",
    "visited",
    "generation",
    "traversals"
  ],
  "title": "NavigationPath",
  "type": "object"
}
