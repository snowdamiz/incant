{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "order": [
    "color",
    "intensity",
    "range"
  ],
  "properties": {
    "color": {
      "items": {
        "format": "double",
        "type": "number"
      },
      "maxItems": 3,
      "minItems": 3,
      "type": "array"
    },
    "intensity": {
      "description": "Luminous intensity in candela.",
      "format": "double",
      "maximum": 1000000,
      "minimum": 0,
      "type": "number"
    },
    "range": {
      "description": "World-space cutoff in meters, independent of entity scale.",
      "format": "double",
      "maximum": 10000,
      "minimum": 0.001,
      "type": "number"
    }
  },
  "required": [
    "color",
    "intensity",
    "range"
  ],
  "title": "PointLight",
  "type": "object"
}
