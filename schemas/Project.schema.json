{
  "$defs": {
    "Asset": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "path",
        "kind",
        "sha256"
      ],
      "type": "object"
    },
    "Entity": {
      "additionalProperties": false,
      "properties": {
        "components": {
          "additionalProperties": true,
          "type": "object"
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "parent": {
          "type": [
            "string",
            "null"
          ]
        },
        "provenance": {
          "anyOf": [
            {
              "$ref": "#/$defs/Provenance"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "name",
        "components"
      ],
      "type": "object"
    },
    "Origin": {
      "enum": [
        "user",
        "agent",
        "script",
        "import"
      ],
      "type": "string"
    },
    "ProjectSettings": {
      "additionalProperties": false,
      "properties": {
        "tick_rate": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "tick_rate"
      ],
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "properties": {
        "actor": {
          "type": "string"
        },
        "conversation_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "origin": {
          "$ref": "#/$defs/Origin"
        },
        "transaction": {
          "type": "string"
        }
      },
      "required": [
        "origin",
        "actor",
        "transaction"
      ],
      "type": "object"
    },
    "Scene": {
      "additionalProperties": false,
      "properties": {
        "entities": {
          "additionalProperties": {
            "$ref": "#/$defs/Entity"
          },
          "type": "object"
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "entities"
      ],
      "type": "object"
    },
    "ScriptSource": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "path": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "path"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "assets": {
      "additionalProperties": {
        "$ref": "#/$defs/Asset"
      },
      "type": "object"
    },
    "id": {
      "type": "string"
    },
    "memory": {
      "additionalProperties": {
        "type": "string"
      },
      "type": "object"
    },
    "name": {
      "type": "string"
    },
    "scenes": {
      "additionalProperties": {
        "$ref": "#/$defs/Scene"
      },
      "type": "object"
    },
    "schema_version": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "scripts": {
      "additionalProperties": {
        "$ref": "#/$defs/ScriptSource"
      },
      "type": "object"
    },
    "settings": {
      "$ref": "#/$defs/ProjectSettings"
    }
  },
  "required": [
    "id",
    "schema_version",
    "name",
    "scenes",
    "assets",
    "scripts",
    "settings",
    "memory"
  ],
  "title": "Project",
  "type": "object"
}
