{
  "$defs": {
    "ActionGesture": {
      "enum": [
        "tap",
        "long_press",
        "swipe"
      ],
      "type": "string"
    },
    "AgentBudgetSettings": {
      "additionalProperties": false,
      "description": "User-authored token allowance for this project. Consumption is stored outside\nthe project; zero disables new agent turns.",
      "properties": {
        "max_tokens": {
          "format": "uint64",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "max_tokens"
      ],
      "type": "object"
    },
    "Asset": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "import_settings": {
          "anyOf": [
            {
              "$ref": "#/$defs/AssetImportSettings"
            },
            {
              "type": "null"
            }
          ]
        },
        "kind": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "path",
        "kind",
        "sha256"
      ],
      "type": "object"
    },
    "AssetImportSettings": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "texture",
              "type": "string"
            },
            "usage": {
              "$ref": "#/$defs/TextureUsage"
            }
          },
          "required": [
            "type",
            "usage"
          ],
          "type": "object"
        }
      ]
    },
    "CoroutineValue": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "format": "double",
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "items": {
            "$ref": "#/$defs/CoroutineValue"
          },
          "type": "array"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/CoroutineValue"
          },
          "type": "object"
        }
      ]
    },
    "EngineRequirement": {
      "description": "SemVer requirement text, preserved exactly rather than silently normalized.\nBuild metadata is not an engine identity: SemVer matching ignores it.",
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "Entity": {
      "additionalProperties": false,
      "properties": {
        "components": {
          "additionalProperties": true,
          "type": "object"
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "parent": {
          "type": [
            "string",
            "null"
          ]
        },
        "prefab": {
          "anyOf": [
            {
              "$ref": "#/$defs/PrefabLink"
            },
            {
              "type": "null"
            }
          ]
        },
        "provenance": {
          "anyOf": [
            {
              "$ref": "#/$defs/Provenance"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "name",
        "components"
      ],
      "type": "object"
    },
    "GamepadAxis": {
      "enum": [
        "left_x",
        "left_y",
        "right_x",
        "right_y"
      ],
      "type": "string"
    },
    "GamepadButton": {
      "enum": [
        "south",
        "east",
        "west",
        "north",
        "left_shoulder",
        "right_shoulder",
        "left_trigger",
        "right_trigger",
        "select",
        "start",
        "guide",
        "left_stick",
        "right_stick",
        "dpad_up",
        "dpad_down",
        "dpad_left",
        "dpad_right"
      ],
      "type": "string"
    },
    "InputAction": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "bindings": {
              "items": {
                "$ref": "#/$defs/InputBinding"
              },
              "maxItems": 16,
              "type": "array"
            },
            "kind": {
              "const": "button",
              "type": "string"
            },
            "threshold": {
              "default": 0.5,
              "format": "double",
              "type": "number"
            }
          },
          "required": [
            "kind",
            "bindings"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "bindings": {
              "items": {
                "$ref": "#/$defs/InputBinding"
              },
              "maxItems": 16,
              "type": "array"
            },
            "dead_zone": {
              "default": 0.15,
              "format": "double",
              "type": "number"
            },
            "kind": {
              "const": "axis1",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "bindings"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "bindings": {
              "items": {
                "$ref": "#/$defs/InputBinding"
              },
              "maxItems": 16,
              "type": "array"
            },
            "dead_zone": {
              "default": 0.15,
              "format": "double",
              "type": "number"
            },
            "kind": {
              "const": "axis2",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "bindings"
          ],
          "type": "object"
        }
      ]
    },
    "InputBinding": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "code": {
              "$ref": "#/$defs/KeyCode"
            },
            "scale": {
              "default": [
                1.0,
                0.0
              ],
              "items": {
                "format": "double",
                "type": "number"
              },
              "maxItems": 2,
              "minItems": 2,
              "type": "array"
            },
            "type": {
              "const": "key",
              "type": "string"
            }
          },
          "required": [
            "type",
            "code"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "button": {
              "$ref": "#/$defs/MouseButton"
            },
            "scale": {
              "default": [
                1.0,
                0.0
              ],
              "items": {
                "format": "double",
                "type": "number"
              },
              "maxItems": 2,
              "minItems": 2,
              "type": "array"
            },
            "type": {
              "const": "mouse_button",
              "type": "string"
            }
          },
          "required": [
            "type",
            "button"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "button": {
              "$ref": "#/$defs/GamepadButton"
            },
            "id": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "scale": {
              "default": [
                1.0,
                0.0
              ],
              "items": {
                "format": "double",
                "type": "number"
              },
              "maxItems": 2,
              "minItems": 2,
              "type": "array"
            },
            "type": {
              "const": "gamepad_button",
              "type": "string"
            }
          },
          "required": [
            "type",
            "id",
            "button"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "axis": {
              "$ref": "#/$defs/GamepadAxis"
            },
            "id": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "scale": {
              "default": [
                1.0,
                0.0
              ],
              "items": {
                "format": "double",
                "type": "number"
              },
              "maxItems": 2,
              "minItems": 2,
              "type": "array"
            },
            "type": {
              "const": "gamepad_axis",
              "type": "string"
            }
          },
          "required": [
            "type",
            "id",
            "axis"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "id": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "invert_y": {
              "default": false,
              "type": "boolean"
            },
            "stick": {
              "$ref": "#/$defs/Stick"
            },
            "type": {
              "const": "gamepad_stick",
              "type": "string"
            }
          },
          "required": [
            "type",
            "id",
            "stick"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "gesture": {
              "$ref": "#/$defs/ActionGesture"
            },
            "scale": {
              "default": [
                1.0,
                0.0
              ],
              "items": {
                "format": "double",
                "type": "number"
              },
              "maxItems": 2,
              "minItems": 2,
              "type": "array"
            },
            "type": {
              "const": "gesture",
              "type": "string"
            }
          },
          "required": [
            "type",
            "gesture"
          ],
          "type": "object"
        }
      ]
    },
    "KeyCode": {
      "description": "Physical key positions. Text entry and IME composition are separate concerns.",
      "enum": [
        "KeyA",
        "KeyB",
        "KeyC",
        "KeyD",
        "KeyE",
        "KeyF",
        "KeyG",
        "KeyH",
        "KeyI",
        "KeyJ",
        "KeyK",
        "KeyL",
        "KeyM",
        "KeyN",
        "KeyO",
        "KeyP",
        "KeyQ",
        "KeyR",
        "KeyS",
        "KeyT",
        "KeyU",
        "KeyV",
        "KeyW",
        "KeyX",
        "KeyY",
        "KeyZ",
        "Digit0",
        "Digit1",
        "Digit2",
        "Digit3",
        "Digit4",
        "Digit5",
        "Digit6",
        "Digit7",
        "Digit8",
        "Digit9",
        "ArrowUp",
        "ArrowDown",
        "ArrowLeft",
        "ArrowRight",
        "Space",
        "Enter",
        "Escape",
        "Tab",
        "Backspace",
        "Delete",
        "Insert",
        "Home",
        "End",
        "PageUp",
        "PageDown",
        "ShiftLeft",
        "ShiftRight",
        "ControlLeft",
        "ControlRight",
        "AltLeft",
        "AltRight",
        "MetaLeft",
        "MetaRight",
        "CapsLock",
        "NumLock",
        "ScrollLock",
        "Pause",
        "PrintScreen",
        "ContextMenu",
        "Backquote",
        "Minus",
        "Equal",
        "BracketLeft",
        "BracketRight",
        "Backslash",
        "Semicolon",
        "Quote",
        "Comma",
        "Period",
        "Slash",
        "Numpad0",
        "Numpad1",
        "Numpad2",
        "Numpad3",
        "Numpad4",
        "Numpad5",
        "Numpad6",
        "Numpad7",
        "Numpad8",
        "Numpad9",
        "NumpadAdd",
        "NumpadSubtract",
        "NumpadMultiply",
        "NumpadDivide",
        "NumpadDecimal",
        "NumpadEnter",
        "F1",
        "F2",
        "F3",
        "F4",
        "F5",
        "F6",
        "F7",
        "F8",
        "F9",
        "F10",
        "F11",
        "F12"
      ],
      "type": "string"
    },
    "LocaleSettings": {
      "additionalProperties": false,
      "properties": {
        "fallbacks": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "locale": {
          "type": "string"
        },
        "pseudo": {
          "default": false,
          "type": "boolean"
        }
      },
      "required": [
        "locale"
      ],
      "type": "object"
    },
    "MouseButton": {
      "enum": [
        "left",
        "right",
        "middle",
        "back",
        "forward"
      ],
      "type": "string"
    },
    "Origin": {
      "enum": [
        "user",
        "agent",
        "script",
        "import"
      ],
      "type": "string"
    },
    "PhysicsMode": {
      "description": "Authoring choice for a separately built simulation process. Fast mode does\nnot promise bit-identical results across hardware or solver variants.",
      "enum": [
        "fast",
        "deterministic"
      ],
      "type": "string"
    },
    "Prefab": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "nodes": {
          "additionalProperties": {
            "$ref": "#/$defs/PrefabNode"
          },
          "type": "object"
        },
        "provenance": {
          "anyOf": [
            {
              "$ref": "#/$defs/Provenance"
            },
            {
              "type": "null"
            }
          ]
        },
        "root": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "root",
        "nodes"
      ],
      "type": "object"
    },
    "PrefabLink": {
      "additionalProperties": false,
      "properties": {
        "node": {
          "type": "string"
        },
        "overrides": {
          "description": "Whole-component overrides. A listed but absent component is removed.",
          "items": {
            "type": "string"
          },
          "maxItems": 64,
          "type": "array",
          "uniqueItems": true
        },
        "root": {
          "type": "string"
        },
        "source": {
          "type": "string"
        }
      },
      "required": [
        "source",
        "root",
        "node"
      ],
      "type": "object"
    },
    "PrefabNode": {
      "additionalProperties": false,
      "properties": {
        "components": {
          "additionalProperties": true,
          "type": "object"
        },
        "name": {
          "type": "string"
        },
        "parent": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "name",
        "components"
      ],
      "type": "object"
    },
    "ProjectSettings": {
      "additionalProperties": false,
      "properties": {
        "agent_budget": {
          "$ref": "#/$defs/AgentBudgetSettings",
          "default": {
            "max_tokens": 1000000
          }
        },
        "input_actions": {
          "additionalProperties": {
            "$ref": "#/$defs/InputAction"
          },
          "type": "object"
        },
        "localization": {
          "$ref": "#/$defs/LocaleSettings"
        },
        "physics_mode": {
          "$ref": "#/$defs/PhysicsMode",
          "default": "deterministic"
        },
        "tick_rate": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "tick_rate"
      ],
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "properties": {
        "actor": {
          "type": "string"
        },
        "conversation_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "origin": {
          "$ref": "#/$defs/Origin"
        },
        "transaction": {
          "type": "string"
        }
      },
      "required": [
        "origin",
        "actor",
        "transaction"
      ],
      "type": "object"
    },
    "RustModuleSource": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        "path": {
          "maxLength": 1024,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "path"
      ],
      "type": "object"
    },
    "Scene": {
      "additionalProperties": false,
      "properties": {
        "entities": {
          "additionalProperties": {
            "$ref": "#/$defs/Entity"
          },
          "type": "object"
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "program": {
          "anyOf": [
            {
              "$ref": "#/$defs/SceneProgram"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "name",
        "entities"
      ],
      "type": "object"
    },
    "SceneProgram": {
      "description": "One scene-wide native module; absent preserves authored TypeScript behavior.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "instances": {
              "additionalProperties": {
                "additionalProperties": {
                  "$ref": "#/$defs/CoroutineValue"
                },
                "type": "object"
              },
              "description": "Immutable startup parameters for this one scene module, keyed by owner.",
              "type": "object"
            },
            "kind": {
              "const": "wasm",
              "type": "string"
            },
            "module": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "module"
          ],
          "type": "object"
        }
      ]
    },
    "ScriptSource": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "path": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "path"
      ],
      "type": "object"
    },
    "Stick": {
      "enum": [
        "left",
        "right"
      ],
      "type": "string"
    },
    "StringTable": {
      "additionalProperties": false,
      "description": "A typed document asset. Message keys remain stable when translations change.",
      "properties": {
        "id": {
          "type": "string"
        },
        "messages": {
          "additionalProperties": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object"
          },
          "description": "Stable key -> canonical BCP-47 locale -> complete message pattern.",
          "type": "object"
        },
        "name": {
          "type": "string"
        },
        "source_locale": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "source_locale",
        "messages"
      ],
      "type": "object"
    },
    "TextureUsage": {
      "enum": [
        "color",
        "linear",
        "normal"
      ],
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "assets": {
      "additionalProperties": {
        "$ref": "#/$defs/Asset"
      },
      "type": "object"
    },
    "engine_version": {
      "anyOf": [
        {
          "$ref": "#/$defs/EngineRequirement"
        },
        {
          "type": "null"
        }
      ]
    },
    "id": {
      "type": "string"
    },
    "memory": {
      "additionalProperties": {
        "type": "string"
      },
      "type": "object"
    },
    "module_sources": {
      "additionalProperties": {
        "$ref": "#/$defs/RustModuleSource"
      },
      "description": "Registered authored Rust entries, separate from compiled Wasm assets.",
      "type": "object"
    },
    "name": {
      "type": "string"
    },
    "prefabs": {
      "additionalProperties": {
        "$ref": "#/$defs/Prefab"
      },
      "type": "object"
    },
    "scenes": {
      "additionalProperties": {
        "$ref": "#/$defs/Scene"
      },
      "type": "object"
    },
    "schema_version": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "scripts": {
      "additionalProperties": {
        "$ref": "#/$defs/ScriptSource"
      },
      "type": "object"
    },
    "settings": {
      "$ref": "#/$defs/ProjectSettings"
    },
    "string_tables": {
      "additionalProperties": {
        "$ref": "#/$defs/StringTable"
      },
      "type": "object"
    }
  },
  "required": [
    "id",
    "schema_version",
    "name",
    "scenes",
    "assets",
    "scripts",
    "settings",
    "memory"
  ],
  "title": "Project",
  "type": "object"
}
