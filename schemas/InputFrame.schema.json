    "disconnected": {
      "items": {
        "format": "uint32",
        "minimum": 0,
        "type": "integer"
      },
      "type": "array",
      "uniqueItems": true
    },
    "focused": {
      "type": "boolean"
    },
    "gamepads": {
      "additionalProperties": false,
      "patternProperties": {
        "^\\d+$": {
          "$ref": "#/$defs/GamepadFrame"
        }
      },
      "type": "object"
    },
    "gestures": {
      "items": {
        "$ref": "#/$defs/Gesture"
      },
      "type": "array"
    },
    "keyboard": {
      "$ref": "#/$defs/Buttons"
    },
    "mouse": {
      "$ref": "#/$defs/MouseFrame"
    },
    "touch_changes": {
      "items": {
        "$ref": "#/$defs/TouchChange"
      },
      "type": "array"
    },
    "touches": {
      "additionalProperties": false,
      "patternProperties": {
        "^\\d+$": {
          "$ref": "#/$defs/TouchPoint"
        }
      },
      "type": "object"
    }
