          "minItems": 3,
          "type": "array"
        },
        "preferred_velocity": {
          "items": {
            "format": "float",
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        },
        "radius": {
          "format": "float",
          "type": "number"
        },
        "responsibility": {
          "format": "float",
          "type": "number"
        },
        "velocity": {
          "items": {
            "format": "float",
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        }
