{
  "$defs": {
    "CameraProjection": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "perspective",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "orthographic",
              "type": "string"
            },
            "vertical_size": {
              "description": "Visible world-space height. Width follows the output aspect ratio.",
              "format": "double",
              "type": "number",
              "x-incant-unit": "m"
            }
          },
          "required": [
            "kind",
            "vertical_size"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "pixel_perfect",
              "type": "string"
            },
            "pixels_per_unit": {
              "description": "Logical pixels per world metre. Camera motion snaps to this grid.",
              "format": "double",
              "maximum": 4096,
              "minimum": 1,
              "type": "number",
              "x-incant-unit": "px/m"
            },
            "reference_resolution": {
              "description": "Fixed logical width and height, scaled by whole pixels with letterboxing.",
              "items": {
                "format": "uint32",
                "minimum": 0,
                "type": "integer"
              },
              "maxItems": 2,
              "minItems": 2,
              "type": "array",
              "x-incant-unit": "px"
            }
          },
          "required": [
            "kind",
            "pixels_per_unit",
            "reference_resolution"
          ],
          "type": "object"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "order": [
    "projection",
    "fov_degrees",
    "near",
    "far"
  ],
  "properties": {
    "far": {
      "format": "double",
      "type": "number",
      "x-incant-unit": "m"
    },
    "fov_degrees": {
      "description": "Vertical perspective field of view, retained when switching projection.",
      "format": "double",
      "type": "number",
      "x-incant-unit": "°"
    },
    "near": {
      "format": "double",
      "type": "number",
      "x-incant-unit": "m"
    },
    "projection": {
      "$ref": "#/$defs/CameraProjection",
      "default": {
        "kind": "perspective"
      },
      "description": "Perspective, orthographic, or pixel-perfect with a fixed logical resolution."
    }
  },
  "required": [
    "fov_degrees",
    "near",
    "far"
  ],
  "title": "Camera",
  "type": "object"
}
