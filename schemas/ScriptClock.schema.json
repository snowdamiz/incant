{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "elapsed_seconds": {
      "format": "double",
      "minimum": 0,
      "type": "number"
    },
    "tick": {
      "format": "uint64",
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "tick",
    "elapsed_seconds"
  ],
  "title": "ScriptClock",
  "type": "object"
}
