{
  "$defs": {
    "ActionGesture": {
      "enum": [
        "tap",
        "long_press",
        "swipe"
      ],
      "type": "string"
    },
    "Asset": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "import_settings": {
          "anyOf": [
            {
              "$ref": "#/$defs/AssetImportSettings"
            },
            {
              "type": "null"
            }
          ]
        },
        "kind": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "path",
        "kind",
        "sha256"
      ],
      "type": "object"
    },
    "AssetImportSettings": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "texture",
              "type": "string"
            },
            "usage": {
              "$ref": "#/$defs/TextureUsage"
            }
          },
          "required": [
            "type",
            "usage"
          ],
          "type": "object"
        }
      ]
    },
    "Entity": {
      "additionalProperties": false,
      "properties": {
        "components": {
          "additionalProperties": true,
          "type": "object"
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "parent": {
          "type": [
            "string",
            "null"
          ]
        },
        "provenance": {
          "anyOf": [
            {
              "$ref": "#/$defs/Provenance"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "name",
        "components"
      ],
      "type": "object"
    },
    "GamepadAxis": {
      "enum": [
        "left_x",
        "left_y",
        "right_x",
        "right_y"
      ],
      "type": "string"
    },
    "GamepadButton": {
      "enum": [
        "south",
        "east",
        "west",
        "north",
        "left_shoulder",
        "right_shoulder",
        "left_trigger",
        "right_trigger",
        "select",
        "start",
        "guide",
        "left_stick",
        "right_stick",
        "dpad_up",
        "dpad_down",
        "dpad_left",
        "dpad_right"
      ],
      "type": "string"
    },
    "InputAction": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "bindings": {
              "items": {
                "$ref": "#/$defs/InputBinding"
              },
              "maxItems": 16,
              "type": "array"
            },
            "kind": {
              "const": "button",
              "type": "string"
            },
            "threshold": {
              "default": 0.5,
              "format": "double",
              "type": "number"
            }
          },
          "required": [
            "kind",
            "bindings"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "bindings": {
              "items": {
                "$ref": "#/$defs/InputBinding"
              },
              "maxItems": 16,
              "type": "array"
            },
            "dead_zone": {
              "default": 0.15,
              "format": "double",
              "type": "number"
            },
            "kind": {
              "const": "axis1",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "bindings"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "bindings": {
              "items": {
                "$ref": "#/$defs/InputBinding"
              },
              "maxItems": 16,
              "type": "array"
            },
            "dead_zone": {
              "default": 0.15,
              "format": "double",
              "type": "number"
            },
            "kind": {
              "const": "axis2",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "bindings"
          ],
          "type": "object"
        }
      ]
    },
    "InputBinding": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "code": {
              "$ref": "#/$defs/KeyCode"
            },
            "scale": {
              "default": [
                1.0,
                0.0
              ],
              "items": {
                "format": "double",
                "type": "number"
              },
              "maxItems": 2,
              "minItems": 2,
              "type": "array"
            },
            "type": {
              "const": "key",
              "type": "string"
            }
          },
          "required": [
            "type",
            "code"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "button": {
              "$ref": "#/$defs/MouseButton"
            },
            "scale": {
              "default": [
                1.0,
                0.0
              ],
              "items": {
                "format": "double",
                "type": "number"
              },
              "maxItems": 2,
              "minItems": 2,
              "type": "array"
            },
            "type": {
              "const": "mouse_button",
              "type": "string"
            }
          },
          "required": [
            "type",
            "button"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "button": {
              "$ref": "#/$defs/GamepadButton"
            },
            "id": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "scale": {
              "default": [
                1.0,
                0.0
              ],
              "items": {
                "format": "double",
                "type": "number"
              },
              "maxItems": 2,
              "minItems": 2,
              "type": "array"
            },
            "type": {
              "const": "gamepad_button",
              "type": "string"
            }
          },
          "required": [
            "type",
            "id",
            "button"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "axis": {
              "$ref": "#/$defs/GamepadAxis"
            },
            "id": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "scale": {
              "default": [
                1.0,
                0.0
              ],
              "items": {
                "format": "double",
                "type": "number"
              },
              "maxItems": 2,
              "minItems": 2,
              "type": "array"
            },
            "type": {
              "const": "gamepad_axis",
              "type": "string"
            }
          },
          "required": [
            "type",
            "id",
            "axis"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "id": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "invert_y": {
              "default": false,
              "type": "boolean"
            },
            "stick": {
              "$ref": "#/$defs/Stick"
            },
            "type": {
              "const": "gamepad_stick",
              "type": "string"
            }
          },
          "required": [
            "type",
            "id",
            "stick"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "gesture": {
              "$ref": "#/$defs/ActionGesture"
            },
            "scale": {
              "default": [
                1.0,
                0.0
              ],
              "items": {
                "format": "double",
                "type": "number"
              },
              "maxItems": 2,
              "minItems": 2,
              "type": "array"
            },
            "type": {
              "const": "gesture",
              "type": "string"
            }
          },
          "required": [
            "type",
            "gesture"
          ],
          "type": "object"
        }
      ]
    },
    "KeyCode": {
      "description": "Physical key positions. Text entry and IME composition are separate concerns.",
      "enum": [
        "KeyA",
        "KeyB",
        "KeyC",
        "KeyD",
        "KeyE",
        "KeyF",
        "KeyG",
        "KeyH",
        "KeyI",
        "KeyJ",
        "KeyK",
        "KeyL",
        "KeyM",
        "KeyN",
        "KeyO",
        "KeyP",
        "KeyQ",
        "KeyR",
        "KeyS",
        "KeyT",
        "KeyU",
        "KeyV",
        "KeyW",
        "KeyX",
        "KeyY",
        "KeyZ",
        "Digit0",
        "Digit1",
        "Digit2",
        "Digit3",
        "Digit4",
        "Digit5",
        "Digit6",
        "Digit7",
        "Digit8",
        "Digit9",
        "ArrowUp",
        "ArrowDown",
        "ArrowLeft",
        "ArrowRight",
        "Space",
        "Enter",
        "Escape",
        "Tab",
        "Backspace",
        "Delete",
        "Insert",
        "Home",
        "End",
        "PageUp",
        "PageDown",
        "ShiftLeft",
        "ShiftRight",
        "ControlLeft",
        "ControlRight",
        "AltLeft",
        "AltRight",
        "MetaLeft",
        "MetaRight",
        "CapsLock",
        "NumLock",
        "ScrollLock",
        "Pause",
        "PrintScreen",
        "ContextMenu",
        "Backquote",
        "Minus",
        "Equal",
        "BracketLeft",
        "BracketRight",
        "Backslash",
        "Semicolon",
        "Quote",
        "Comma",
        "Period",
        "Slash",
        "Numpad0",
        "Numpad1",
        "Numpad2",
        "Numpad3",
        "Numpad4",
        "Numpad5",
        "Numpad6",
        "Numpad7",
        "Numpad8",
        "Numpad9",
        "NumpadAdd",
        "NumpadSubtract",
        "NumpadMultiply",
        "NumpadDivide",
        "NumpadDecimal",
        "NumpadEnter",
        "F1",
        "F2",
        "F3",
        "F4",
        "F5",
        "F6",
        "F7",
        "F8",
        "F9",
        "F10",
        "F11",
        "F12"
      ],
      "type": "string"
    },
    "MouseButton": {
      "enum": [
        "left",
        "right",
        "middle",
        "back",
        "forward"
      ],
      "type": "string"
    },
    "Origin": {
      "enum": [
        "user",
        "agent",
        "script",
        "import"
      ],
      "type": "string"
    },
    "Project": {
      "additionalProperties": false,
      "properties": {
        "assets": {
          "additionalProperties": {
            "$ref": "#/$defs/Asset"
          },
          "type": "object"
        },
        "id": {
          "type": "string"
        },
        "memory": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "name": {
          "type": "string"
        },
        "scenes": {
          "additionalProperties": {
            "$ref": "#/$defs/Scene"
          },
          "type": "object"
        },
        "schema_version": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "scripts": {
          "additionalProperties": {
            "$ref": "#/$defs/ScriptSource"
          },
          "type": "object"
        },
        "settings": {
          "$ref": "#/$defs/ProjectSettings"
        }
      },
      "required": [
        "id",
        "schema_version",
        "name",
        "scenes",
        "assets",
        "scripts",
        "settings",
        "memory"
      ],
      "type": "object"
    },
    "ProjectSettings": {
      "additionalProperties": false,
      "properties": {
        "input_actions": {
          "additionalProperties": {
            "$ref": "#/$defs/InputAction"
          },
          "type": "object"
        },
        "tick_rate": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "tick_rate"
      ],
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "properties": {
        "actor": {
          "type": "string"
        },
        "conversation_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "origin": {
          "$ref": "#/$defs/Origin"
        },
        "transaction": {
          "type": "string"
        }
      },
      "required": [
        "origin",
        "actor",
        "transaction"
      ],
      "type": "object"
    },
    "Scene": {
      "additionalProperties": false,
      "properties": {
        "entities": {
          "additionalProperties": {
            "$ref": "#/$defs/Entity"
          },
          "type": "object"
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "entities"
      ],
      "type": "object"
    },
    "Schedule": {
      "additionalProperties": false,
      "properties": {
        "clock": {
          "$ref": "#/$defs/ScriptClock"
        },
        "timers": {
          "additionalProperties": {
            "$ref": "#/$defs/Timer"
          },
          "type": "object"
        }
      },
      "required": [
        "clock",
        "timers"
      ],
      "type": "object"
    },
    "ScriptClock": {
      "additionalProperties": false,
      "properties": {
        "elapsed_seconds": {
          "format": "double",
          "minimum": 0,
          "type": "number"
        },
        "tick": {
          "format": "uint64",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "tick",
        "elapsed_seconds"
      ],
      "type": "object"
    },
    "ScriptSource": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "path": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "path"
      ],
      "type": "object"
    },
    "Stick": {
      "enum": [
        "left",
        "right"
      ],
      "type": "string"
    },
    "TextureUsage": {
      "enum": [
        "color",
        "linear",
        "normal"
      ],
      "type": "string"
    },
    "Timer": {
      "additionalProperties": false,
      "properties": {
        "due_tick": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "interval_ticks": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "payload": true
      },
      "required": [
        "due_tick",
        "payload"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The published wire schema. Decode through `PlaySession::from_save` to apply\nsemantic checks; serde alone does not establish a valid game save.",
  "properties": {
    "authored_sha256": {
      "type": "string"
    },
    "elapsed_seconds": {
      "format": "double",
      "type": "number"
    },
    "format": {
      "type": "string"
    },
    "project": {
      "$ref": "#/$defs/Project"
    },
    "schedule": {
      "anyOf": [
        {
          "$ref": "#/$defs/Schedule"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Version 1 has no schedule; version 2 requires this data-only schedule."
    },
    "script_sha256": {
      "type": "string"
    },
    "script_state": true,
    "tick": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "version": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "format",
    "version",
    "authored_sha256",
    "script_sha256",
    "tick",
    "elapsed_seconds",
    "project",
    "script_state"
  ],
  "title": "GameSave",
  "type": "object"
}
