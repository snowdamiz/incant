{
  "$defs": {
    "Asset": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "import_settings": {
          "anyOf": [
            {
              "$ref": "#/$defs/AssetImportSettings"
            },
            {
              "type": "null"
            }
          ]
        },
        "kind": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "path",
        "kind",
        "sha256"
      ],
      "type": "object"
    },
    "AssetImportSettings": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "texture",
              "type": "string"
            },
            "usage": {
              "$ref": "#/$defs/TextureUsage"
            }
          },
          "required": [
            "type",
            "usage"
          ],
          "type": "object"
        }
      ]
    },
    "Entity": {
      "additionalProperties": false,
      "properties": {
        "components": {
          "additionalProperties": true,
          "type": "object"
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "parent": {
          "type": [
            "string",
            "null"
          ]
        },
        "provenance": {
          "anyOf": [
            {
              "$ref": "#/$defs/Provenance"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "name",
        "components"
      ],
      "type": "object"
    },
    "Origin": {
      "enum": [
        "user",
        "agent",
        "script",
        "import"
      ],
      "type": "string"
    },
    "Project": {
      "additionalProperties": false,
      "properties": {
        "assets": {
          "additionalProperties": {
            "$ref": "#/$defs/Asset"
          },
          "type": "object"
        },
        "id": {
          "type": "string"
        },
        "memory": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "name": {
          "type": "string"
        },
        "scenes": {
          "additionalProperties": {
            "$ref": "#/$defs/Scene"
          },
          "type": "object"
        },
        "schema_version": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "scripts": {
          "additionalProperties": {
            "$ref": "#/$defs/ScriptSource"
          },
          "type": "object"
        },
        "settings": {
          "$ref": "#/$defs/ProjectSettings"
        }
      },
      "required": [
        "id",
        "schema_version",
        "name",
        "scenes",
        "assets",
        "scripts",
        "settings",
        "memory"
      ],
      "type": "object"
    },
    "ProjectSettings": {
      "additionalProperties": false,
      "properties": {
        "tick_rate": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "tick_rate"
      ],
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "properties": {
        "actor": {
          "type": "string"
        },
        "conversation_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "origin": {
          "$ref": "#/$defs/Origin"
        },
        "transaction": {
          "type": "string"
        }
      },
      "required": [
        "origin",
        "actor",
        "transaction"
      ],
      "type": "object"
    },
    "Scene": {
      "additionalProperties": false,
      "properties": {
        "entities": {
          "additionalProperties": {
            "$ref": "#/$defs/Entity"
          },
          "type": "object"
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "entities"
      ],
      "type": "object"
    },
    "Schedule": {
      "additionalProperties": false,
      "properties": {
        "clock": {
          "$ref": "#/$defs/ScriptClock"
        },
        "timers": {
          "additionalProperties": {
            "$ref": "#/$defs/Timer"
          },
          "type": "object"
        }
      },
      "required": [
        "clock",
        "timers"
      ],
      "type": "object"
    },
    "ScriptClock": {
      "additionalProperties": false,
      "properties": {
        "elapsed_seconds": {
          "format": "double",
          "minimum": 0,
          "type": "number"
        },
        "tick": {
          "format": "uint64",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "tick",
        "elapsed_seconds"
      ],
      "type": "object"
    },
    "ScriptSource": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "path": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "path"
      ],
      "type": "object"
    },
    "TextureUsage": {
      "enum": [
        "color",
        "linear",
        "normal"
      ],
      "type": "string"
    },
    "Timer": {
      "additionalProperties": false,
      "properties": {
        "due_tick": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "interval_ticks": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "payload": true
      },
      "required": [
        "due_tick",
        "payload"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The published wire schema. Decode through `PlaySession::from_save` to apply\nsemantic checks; serde alone does not establish a valid game save.",
  "properties": {
    "authored_sha256": {
      "type": "string"
    },
    "elapsed_seconds": {
      "format": "double",
      "type": "number"
    },
    "format": {
      "type": "string"
    },
    "project": {
      "$ref": "#/$defs/Project"
    },
    "schedule": {
      "anyOf": [
        {
          "$ref": "#/$defs/Schedule"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Version 1 has no schedule; version 2 requires this data-only schedule."
    },
    "script_sha256": {
      "type": "string"
    },
    "script_state": true,
    "tick": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "version": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "format",
    "version",
    "authored_sha256",
    "script_sha256",
    "tick",
    "elapsed_seconds",
    "project",
    "script_state"
  ],
  "title": "GameSave",
  "type": "object"
}
