{
  "name": "@incant/editor-ui",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "Incant editor web UI (Phase 0 Spike 6 shell). Engine state arrives through an injected typed bridge.",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b --noEmit",
