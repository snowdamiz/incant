// Test-only unit-output-pixel integration; no production/cooker admission.
// Positive 8-point Gauss-Legendre rule, generated by Newton iteration and
// verified against moments 0..15. Nodes/weights below are mapped to [-.5,.5].
const FOOTPRINT_NODES:array<f32,8> = array<f32,8>(-0.48014492824876814,-0.39833323870681342,-0.2627662049581645,-0.09171732124782489,0.09171732124782489,0.2627662049581645,0.39833323870681342,0.48014492824876814);
const FOOTPRINT_WEIGHTS:array<f32,8> = array<f32,8>(0.050614268145188088,0.11119051722668723,0.15685332293894369,0.181341891689181,0.181341891689181,0.15685332293894369,0.11119051722668723,0.050614268145188088);
fn footprint_axis(d:f32,rho:f32)->f32 {
    var sum=0.0;
    let denominator=2.0*rho*rho;
    for(var i=0u;i<8u;i++) {
        let offset=d+FOOTPRINT_NODES[i];
        sum+=FOOTPRINT_WEIGHTS[i]*exp(-(offset*offset)/denominator);
    }
    return sum;
}
fn footprint_weight(d:vec2f,rho:f32,r:f32)->f32 {
    return r*r/(6.283185307*rho*rho)*footprint_axis(d.x,rho)*footprint_axis(d.y,rho);
}
// Exact existing center projection, rho and r-squared factor. The assembled
// Footprint variant renames only the original kernel_weight definition.
fn kernel_weight(p:vec2f,t:vec2i)->f32 {
    let r=frame.output.z/frame.source.z;
    let rho=0.35+0.325*max(r-2.0,0.0);
    let at=frame.output.xy+((vec2f(t)+vec2f(0.5)-frame.source.xy)/frame.source.zw-frame.jitter.xy)*frame.output.zw;
    return footprint_weight(p-at,rho,r);
}
