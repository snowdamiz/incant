;; Real development/static conformance controls. dt * 64 selects a mode.
(module
  (import "incant_log_v1" "write" (func $log (param i64 i32 i32 i32)))
  (import "incant_v1" "read_transforms" (func $read (param i64 i32 i32)))
  (import "incant_v1" "write_transforms" (func $write (param i64 i32 i32)))
  (import "incant_v1" "read_ids" (func $ids (param i64 i32 i32)))
  (import "incant_v1" "set_parent" (func $parent (param i64 i32 i32)))
  (memory (export "memory") 1)
  (data (i32.const 0) "hello")
  (data (i32.const 16) "\e9\9b\aa\f0\9f\99\82\0a\09")
  (data (i32.const 32) "careful")
  (data (i32.const 48) "problem")
  (data (i32.const 64) "bounded")
  (data (i32.const 96) "pending")
  (data (i32.const 112) "\c0\af\00\0d\1b\c2\85\ed\a0\80")
  (func (export "incant_abi") (result i32) (i32.const 1))
  (func $repeat (param $e i64) (param $count i32) (param $ptr i32) (param $len i32)
    (local $i i32)
    (loop $again
      (call $log (local.get $e) (i32.const 1) (local.get $ptr) (local.get $len))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br_if $again (i32.lt_u (local.get $i) (local.get $count)))))
  (func (export "update") (param $e i64) (param $dt f64)
    (local $mode i32)
    (local.set $mode (i32.trunc_f64_u (f64.mul (local.get $dt) (f64.const 64))))
    (call $read (local.get $e) (i32.const 0) (i32.const 4096))
    (f64.store (i32.const 4096) (f64.add (f64.load (i32.const 4096)) (f64.const 1)))
    (call $write (local.get $e) (i32.const 0) (i32.const 4096))
    (memory.fill (i32.const 1024) (i32.const 120) (i32.const 1025))
    (if (i32.eq (local.get $mode) (i32.const 1)) (then
      (call $log (local.get $e) (i32.const 1) (i32.const 0) (i32.const 5))
      (call $log (local.get $e) (i32.const 0) (i32.const 16) (i32.const 9))
      (call $log (local.get $e) (i32.const 1) (i32.const 65536) (i32.const 0))
      (call $log (local.get $e) (i32.const 2) (i32.const 32) (i32.const 7))
      (call $log (local.get $e) (i32.const 3) (i32.const 48) (i32.const 7))
      ;; Mutation after import proves each diagnostic was copied during the call.
      (i32.store8 (i32.const 0) (i32.const 88))
      (return)))
    (if (i32.eq (local.get $mode) (i32.const 2)) (then
      (call $repeat (local.get $e) (i32.const 64) (i32.const 64) (i32.const 7)) (return)))
    (if (i32.eq (local.get $mode) (i32.const 3)) (then
      (call $repeat (local.get $e) (i32.const 16) (i32.const 1024) (i32.const 1024)) (return)))
    (if (i32.eq (local.get $mode) (i32.const 22)) (then
      (call $repeat (local.get $e) (i32.const 16) (i32.const 1024) (i32.const 1024))
      (call $repeat (local.get $e) (i32.const 48) (i32.const 65536) (i32.const 0)) (return)))
    (call $log (local.get $e) (i32.const 1) (i32.const 96) (i32.const 7))
    (if (i32.eq (local.get $mode) (i32.const 4)) (then (call $log (local.get $e) (i32.const 1) (i32.const 1024) (i32.const 1025))))
    (if (i32.eq (local.get $mode) (i32.const 5)) (then (call $repeat (local.get $e) (i32.const 64) (i32.const 65536) (i32.const 0))))
    (if (i32.eq (local.get $mode) (i32.const 6)) (then (call $repeat (local.get $e) (i32.const 16) (i32.const 1024) (i32.const 1024))))
    (if (i32.eq (local.get $mode) (i32.const 7)) (then (call $log (local.get $e) (i32.const 4) (i32.const 0) (i32.const 5))))
    (if (i32.eq (local.get $mode) (i32.const 8)) (then (call $log (local.get $e) (i32.const 1) (i32.const 112) (i32.const 2))))
    (if (i32.eq (local.get $mode) (i32.const 9)) (then (call $log (local.get $e) (i32.const 1) (i32.const 114) (i32.const 1))))
    (if (i32.eq (local.get $mode) (i32.const 10)) (then (call $log (local.get $e) (i32.const 1) (i32.const -1) (i32.const 0))))
    (if (i32.eq (local.get $mode) (i32.const 11)) (then (call $log (local.get $e) (i32.const 1) (i32.const 65535) (i32.const 2))))
    (if (i32.eq (local.get $mode) (i32.const 12)) (then (call $log (local.get $e) (i32.const 1) (i32.const 0) (i32.const -1))))
    (if (i32.eq (local.get $mode) (i32.const 13)) (then (call $log (i64.sub (local.get $e) (i64.const 1)) (i32.const 1) (i32.const 0) (i32.const 5))))
    (if (i32.eq (local.get $mode) (i32.const 14)) (then unreachable))
    (if (i32.eq (local.get $mode) (i32.const 15)) (then (call $ids (local.get $e) (i32.const 0) (i32.const 8192)) (call $parent (local.get $e) (i32.const 8192) (i32.const 8192))))
    (if (i32.eq (local.get $mode) (i32.const 16)) (then (f64.store (i32.const 4096) (f64.const nan)) (call $write (local.get $e) (i32.const 0) (i32.const 4096))))
    (if (i32.eq (local.get $mode) (i32.const 17)) (then (call $log (local.get $e) (i32.const 1) (i32.const 117) (i32.const 2))))
    (if (i32.eq (local.get $mode) (i32.const 18)) (then (call $log (local.get $e) (i32.const 1) (i32.const 119) (i32.const 3))))
    (if (i32.eq (local.get $mode) (i32.const 19)) (then (call $log (local.get $e) (i32.const 1) (i32.const 115) (i32.const 1))))
    (if (i32.eq (local.get $mode) (i32.const 20)) (then (call $log (local.get $e) (i32.const 1) (i32.const 116) (i32.const 1))))
    (if (i32.eq (local.get $mode) (i32.const 21)) (then (call $log (local.get $e) (i32.const -1) (i32.const 2147483647) (i32.const 1))))
  ))
