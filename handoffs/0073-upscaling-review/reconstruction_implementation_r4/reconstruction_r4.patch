+    [0.1875, -0.0625],
+];
+pub(crate) fn offset(phase: u32, upscaled: bool) -> [f32; 2] {
+    let samples = if upscaled { &UPSCALE_SAMPLES } else { &SAMPLES };
+    samples[phase as usize % samples.len()]
