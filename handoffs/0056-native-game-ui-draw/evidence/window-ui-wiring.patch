+/// Logical UI size of a physical surface at the window's current scale factor.
+fn logical_viewport(size: [u32; 2], scale_factor: f64) -> [f32; 2] {
+    size.map(|n| ((f64::from(n) / scale_factor) as f32).max(1.))
+}
+/// Keep the UI viewport equal to the reserved surface in logical pixels before
+/// a frame is presented. Relayout is presentation only: no tick advances.
+fn fit_ui(
+    game: &mut Game,
+    surface: &mut SurfaceState,
+    window: &tao::window::Window,
+) -> session::Result<u64> {
+    let wanted = logical_viewport(surface.size(), window.scale_factor());
+    let current = game.host()?.ui_input().map(|input| input.viewport);
+    if current == Some(wanted) {
+        return Ok(0);
+    }
+    if let Err(error) = game.resize_ui(wanted) {
+        surface.cancel();
+        return Err(error.into());
+    }
+    Ok(1)
 }

