+/* Incant additive accessor: no allocation, scan, GC, or state change.
+   Caller must exclusively own the runtime, as for JS_ComputeMemoryUsage. */
+void JS_GetMallocState(JSRuntime *rt, size_t *allocated_bytes,
+                       size_t *allocation_count, size_t *limit_bytes)
+{
+    *allocated_bytes = rt->malloc_state.malloc_size;
+    *allocation_count = rt->malloc_state.malloc_count;
+    *limit_bytes = rt->malloc_state.malloc_limit;
 }
 
